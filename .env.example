# ==============================================================================
# ContentPilot AI - Environment Configuration Template
# ==============================================================================
# IMPORTANT: Copy this file to .env before starting backend or frontend services.
# NEVER commit your actual .env file or real secrets into version control.

# Application Settings
ENVIRONMENT=development
APP_NAME=ContentPilot AI
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Security and Authentication
# Generate a secure secret key: `openssl rand -hex 32` or `python -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=change-this-to-a-very-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Primary: Managed or local PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/contentpilot_ai
# SQLite Fallback for instant zero-dependency local dev / unit testing
USE_SQLITE_FALLBACK=True
SQLITE_DATABASE_URL=sqlite:///./contentpilot.db

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# AI / LLM Provider Configuration
# Supported providers: 'mock' (default for tests/no keys), 'openai', 'gemini', 'anthropic', 'watsonx'
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# Default Workspace & Brand Settings
DEFAULT_LANGUAGE=English
SUPPORTED_LANGUAGES=English,Hindi,Marathi
DEFAULT_TIMEZONE=UTC
